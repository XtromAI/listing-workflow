EBAY_CLIENT_ID=your_client_id
EBAY_CLIENT_SECRET=your_client_secret
EBAY_REFRESH_TOKEN=your_refresh_token
EBAY_RUNAME=your_runame
EBAY_ENVIRONMENT=production

EBAY_FULFILLMENT_POLICY_ID=your_policy_id
EBAY_PAYMENT_POLICY_ID=your_policy_id
EBAY_RETURN_POLICY_ID=your_policy_id
# Key chosen when running ebay_create_merchant_location (provides Item.Country for publish)
EBAY_MERCHANT_LOCATION_KEY=default-location

GOOGLE_VISION_API_KEY=your_google_vision_key

# Google Gemini API key — from Google AI Studio (ai.google.dev)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3-flash-preview

# Etsy credentials
# API key from https://www.etsy.com/developers/your-apps
ETSY_API_KEY=your_etsy_api_key
ETSY_CLIENT_ID=your_etsy_client_id
# Obtain via OAuth flow with scopes: listings_w listings_r
# Note: Etsy rotates refresh tokens — the server logs the new token to stderr on each refresh
ETSY_REFRESH_TOKEN=your_etsy_refresh_token

# Your Etsy shop numeric ID (visible in Etsy shop manager URL)
ETSY_SHOP_ID=your_shop_id

# Etsy business policy IDs (from Shop Manager > Settings > Shipping & Returns)
ETSY_SHIPPING_PROFILE_ID=your_shipping_profile_id
ETSY_RETURN_POLICY_ID=your_return_policy_id

# Cloud Function env vars — set via gcloud --set-env-vars, not needed by mcp-server
# EBAY_VERIFICATION_TOKEN=your_random_token
# NOTIFICATION_ENDPOINT_URL=https://your-function-hash-uc.a.run.app
